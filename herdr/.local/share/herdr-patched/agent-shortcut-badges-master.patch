+fn agent_shortcut_number(entry_index: usize, entry_count: usize) -> Option<usize> {
+    if entry_index < 8 {
+        Some(entry_index + 1)
+    } else if entry_index + 1 == entry_count {
+        Some(9)
+    } else {
+        None
+    }
+}
+
+fn agent_shortcut_glyph(
+    entry_index: usize,
+    entry_count: usize,
+    is_active: bool,
+) -> Option<&'static str> {
+    const OUTLINE: [&str; 9] = ["①", "②", "③", "④", "⑤", "⑥", "⑦", "⑧", "⑨"];
+    const FILLED: [&str; 9] = ["❶", "❷", "❸", "❹", "❺", "❻", "❼", "❽", "❾"];
+    let number = agent_shortcut_number(entry_index, entry_count)?;
+    Some(if is_active {
+        FILLED[number - 1]
+    } else {
+        OUTLINE[number - 1]
+    })
+}
