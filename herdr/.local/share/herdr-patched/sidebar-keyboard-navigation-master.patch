+fn move_sidebar_navigation_selection(state: &mut AppState, delta: isize) {
+    match state.sidebar_navigation_target {
+        SidebarNavigationTarget::Workspaces => {
+            state.move_selected_workspace_by_visible_delta(delta)
+        }
+        SidebarNavigationTarget::Agents => {
+            let count = crate::ui::agent_panel_entries(state).len();
+            if count == 0 {
+                return;
+            }
+            state.selected_agent = state
+                .selected_agent
+                .saturating_add_signed(delta)
+                .min(count - 1);
+            state.ensure_agent_panel_entry_visible(state.selected_agent);
+        }
+    }
